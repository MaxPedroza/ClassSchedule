rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspaceMember(workspaceId) {
      return signedIn()
        && request.auth.token.workspaceId == workspaceId
        && request.auth.token.role in ['admin', 'secretary', 'teacher', 'student'];
    }

    function manager(workspaceId) {
      return workspaceMember(workspaceId)
        && request.auth.token.role in ['admin', 'secretary']
        && (request.auth.token.role != 'admin' || request.auth.uid == workspaceId);
    }

    function ownStudent(studentId) {
      return signedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.profileId == studentId;
    }

    function ownTeacher(teacherId) {
      return signedIn()
        && request.auth.token.role == 'teacher'
        && request.auth.token.profileId == teacherId;
    }

    function validClass(classId) {
      return request.resource.data.keys().hasAll([
          'id', 'date', 'start', 'end', 'studentId', 'teacherId'
        ])
        && request.resource.data.id == classId
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.studentId is string
        && request.resource.data.teacherId is string;
    }

    match /users/{workspaceId}/students/{studentId} {
      allow get: if manager(workspaceId) || (workspaceMember(workspaceId) && ownStudent(studentId));
      allow list: if manager(workspaceId);
      allow create, update, delete: if manager(workspaceId);
    }

    match /users/{workspaceId}/teachers/{teacherId} {
      allow get: if manager(workspaceId) || (workspaceMember(workspaceId) && ownTeacher(teacherId));
      allow list: if manager(workspaceId);
      allow create, update, delete: if manager(workspaceId);
    }

    match /users/{workspaceId}/classes/{classId} {
      allow get, list: if manager(workspaceId)
        || (workspaceMember(workspaceId) && (
          ownStudent(resource.data.studentId)
          || ownTeacher(resource.data.teacherId)
        ));
      allow create, update: if manager(workspaceId) && validClass(classId);
      allow delete: if manager(workspaceId);
    }

    match /users/{workspaceId}/scheduleDays/{date} {
      allow read, write: if manager(workspaceId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
