{
  "name": "classschedule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test lib/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-classschedule --only firestore \"node --test test/firestore.rules.test.js\"",
    "set:role": "node scripts/set-user-role.js",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.34.2",
    "vite": "^7.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
